  <library_effects>
    <effect id="Material_0-effect">
      <profile_COMMON>
        <newparam sid="DiffuseMap_0_jpg-surface">
          <surface type="2D">
            <init_from>DiffuseMap_0_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="DiffuseMap_0_jpg-sampler">
          <sampler2D>
            <source>DiffuseMap_0_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="DiffuseMap_0_jpg-sampler" texcoord="DefaultUV"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">1</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
