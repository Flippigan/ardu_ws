# Exact snapshot of every repo in ardu_ws/src as of 2026-10-08.
# Each repo is pinned to a commit hash. Where the snapshot included local/uncommitted
# work, that commit lives on a branch named share/2026-10-08 in the Flippigan fork.
#
# Import with:  vcs import --recursive src < workspace.repos
repositories:
  src/apriltag_msgs:
    type: git
    url: https://github.com/christianrauch/apriltag_msgs.git
    version: 84bd66c0120f340365437929d564ef390513387d   # tag 2.0.1
